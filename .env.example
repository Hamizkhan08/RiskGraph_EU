# ---------- Backend (server-side only; never expose in the browser) ----------
RISKGRAPH_BUNDLE_DIR=artifacts/demo
RISKGRAPH_DB_PATH=riskgraph_decisions.db
RISKGRAPH_DEMO_MODE=true                      # decisions are labelled SIMULATED FEEDBACK
RISKGRAPH_CORS_ORIGINS=http://localhost:3000  # comma-separated exact origins
RISKGRAPH_RATE_LIMIT_PER_MIN=120
RISKGRAPH_SIMULATE_ENABLED=true
# RISKGRAPH_API_KEY=                          # optional: if set, POST decisions and /api/audit require header X-API-Key
# ---------- Frontend (see frontend/.env.example) ----------
# NEXT_PUBLIC_API_URL=http://localhost:8000   # public by design; leave empty for demo mode
